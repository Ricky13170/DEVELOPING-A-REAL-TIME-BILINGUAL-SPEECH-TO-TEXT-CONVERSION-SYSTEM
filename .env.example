# TheDuo Edge runtime defaults. Public reference models need no API key.
WHISPER_MODEL=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
CPU_THREADS=2
TRANSLATION_MODEL_VI_EN=Helsinki-NLP/opus-mt-vi-en
TRANSLATION_MODEL_EN_VI=Helsinki-NLP/opus-mt-en-vi
TRANSLATION_DEVICE=cpu
ENABLE_PARTIAL_TRANSCRIPTS=false
MAX_HALLUCINATION_RETRIES=0

# Optional cloud-only context/summary extras. Keep disabled for offline demos.
ENABLE_GROQ=false
GROQ_API_KEY=

# Optional Docker packages. Both stay off for the smallest CPU image.
INSTALL_WEBRTC=0
INSTALL_GROQ=0
